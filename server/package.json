{
  "name": "renewal-register-server",
  "private": true,
  "version": "0.1.0",
  "description": "Local demo API: Express + SQLite behind the monthly renewal register",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --watch-path=src src/index.js",
    "migrate": "node src/db.js",
    "reset": "node scripts/reset-demo.mjs",
    "set-password": "node scripts/set-password.mjs",
    "import-sheet": "node scripts/import-sheet.mjs"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "express": "4.21.2"
  }
}
