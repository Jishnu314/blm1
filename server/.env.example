# Copy this file to `.env` for the legacy local Express helper or Sheet import.
# `.env` is never committed. Production secrets belong in Supabase Edge Function
# Secrets, not here.

# Where Postgres is. The one variable with no sensible default — the server
# refuses to start without it.
DATABASE_URL=postgres://user:password@localhost:5432/renewal_register

# TLS to the database. `auto` turns it on for any host that is not this machine,
# which is what Supabase needs; `require` forces it on, `off`
# forces it off. See the note in README.md about certificate checking.
DATABASE_SSL=auto

# The port to listen on. 8787 is
# the number vite.config.js proxies /api to, so changing it here means changing it
# there as well.
PORT=8787

# `production` makes the session cookie `Secure`, so it only travels over https.
NODE_ENV=development

# Optional, for when the website is hosted separately from this API server.
# List exact website origins, comma separated, with no path (for example
# https://renewals.example.com). Leave empty for the normal same-origin setup.
CORS_ORIGINS=
# With a split production frontend, COOKIE_SAME_SITE defaults to `none` and the
# session cookie is Secure. Override only if your deployment needs another mode.
COOKIE_SAME_SITE=

# Used ONCE, to create the admin account the first time the server sees an empty
# database. After that it is ignored — change the password with
# `npm run set-password -- "a new one"` or from the admin page.
ADMIN_PASSWORD=

# The Apps Script /exec URL, so the Google Sheet keeps getting a copy of every
# write. Leave it empty and there is no sheet copy at all and nothing is queued —
# the app is complete without it. This is the only place this URL now lives; it
# used to be baked into the published JavaScript.
SHEET_WEBHOOK_URL=

# Set to 1 when something else terminates TLS in front of this process. Without it
# every request looks like it came from the proxy, and the rate
# limits would then be shared by everybody instead of being per phone.
TRUST_PROXY=
