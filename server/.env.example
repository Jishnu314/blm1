# Local demo API. Copy to `.env` only if you want to override defaults.
# The register is a SQLite file on this PC — not the production database.

# Optional. Defaults to server/data/demo.sqlite
# SQLITE_PATH=

# Leave as 1 for the local demo (sample data + printed demo password).
DEMO_MODE=1

PORT=8787
NODE_ENV=development

# Optional override. If empty in demo mode, the password is demo-admin-10
ADMIN_PASSWORD=

# Optional Google Sheet copy. Leave empty for local demo.
SHEET_WEBHOOK_URL=

CORS_ORIGINS=
COOKIE_SAME_SITE=
TRUST_PROXY=
